{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "defaultMode": "manual",
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(glab mr view *)",
      "Bash(glab mr diff *)",
      "Bash(glab ci trace *)",
      "Bash(glab auth status)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl config current-context)",
      "Bash(helm template *)",
      "Bash(helm lint *)",
      "Bash(nix eval *)",
      "Bash(terragrunt plan *)",
      "Bash(aws sts get-caller-identity)",
      "Bash(aws ecr describe-images *)",
      "Bash(aws cloudwatch get-metric-statistics *)",
      "Bash(aws cloudtrail lookup-events *)",
      "mcp__plugin_gitlab_gitlab__get_*",
      "mcp__plugin_gitlab_gitlab__search*",
      "mcp__plugin_gitlab_gitlab__semantic_code_search",
      "mcp__plugin_slack_slack__slack_read_*",
      "mcp__plugin_slack_slack__slack_search_*",
      "mcp__plugin_slack_slack__slack_get_*",
      "mcp__plugin_slack_slack__slack_list_*",
      "mcp__plugin_linear_linear__list_*",
      "mcp__plugin_linear_linear__get_*",
      "mcp__plugin_Notion_notion__notion-fetch",
      "mcp__plugin_Notion_notion__notion-search",
      "mcp__plugin_mcps_honeycomb__get_*",
      "mcp__plugin_mcps_honeycomb__find_*",
      "mcp__plugin_mcps_honeycomb__list_*",
      "mcp__plugin_mcps_honeycomb__search_*",
      "mcp__plugin_mcps_honeycomb__run_query",
      "mcp__plugin_mcps_honeycomb__run_bubbleup",
      "Bash(aws acm describe-*)",
      "Bash(aws acm list-*)",
      "Bash(aws ec2 describe-*)",
      "Bash(aws elbv2 describe-*)",
      "Bash(aws route53 list-*)",
      "Bash(dig *)",
      "Bash(git -C /Users/shane.hull/remote-com/devops/argocd-config log *)",
      "Bash(git -C /Users/shane.hull/remote-com/devops/argocd-config ls-tree *)",
      "Bash(git -C /Users/shane.hull/remote-com/devops/argocd-config show *)",
      "Bash(git -C /Users/shane.hull/remote-com/devops/argocd-config worktree list*)",
      "Bash(git -C /Users/shane.hull/remote-com/devops/infra-live diff *)",
      "Bash(git -C /Users/shane.hull/remote-com/devops/infra-live log *)",
      "Bash(git -C /Users/shane.hull/remote-com/devops/infra-live show *)",
      "Bash(git -C /Users/shane.hull/remote-com/devops/infra-live worktree list*)",
      "Bash(kubectl config get-contexts*)",
      "Bash(kubectl describe *)",
      "Bash(kubectl explain *)",
      "Bash(openssl x509 *)",
      "Bash(terragrunt state list*)",
      "mcp__dexter__dexter_call_hierarchy",
      "mcp__dexter__dexter_definition",
      "mcp__dexter__dexter_file_outline",
      "mcp__dexter__dexter_implementations",
      "mcp__dexter__dexter_module_api",
      "mcp__dexter__dexter_references",
      "mcp__dexter__dexter_search",
      "mcp__dexter__dexter_workspace"
    ]
  },
  "enabledPlugins": {
    "mcps@shane-mcps": true,
    "linear@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "aikido@claude-plugins-official": true,
    "sre-security-patch-day@remote-claude-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "shane-mcps": {
      "source": {
        "source": "directory",
        "path": "~/.config/claude/marketplace"
      }
    },
    "remote-claude-plugins": {
      "source": {
        "source": "git",
        "url": "git@gitlab.com:remote-com/claude-code-plugin-marketplace.git"
      }
    }
  },
  "theme": "dark-ansi",
  "includeCoAuthouredBy": false,
  "model": "opus[1m]"
}
